<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvItemTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Họp nhóm đồ án"
        android:textColor="#0F172A"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvItemLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Địa điểm: Phòng B203"
        android:textColor="#475569"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E0F2F1"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="25/10/2026  •  09:00"
            android:textColor="#00695C"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvItemReminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="#FEF3C7"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Có nhắc"
            android:textColor="#B45309"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>